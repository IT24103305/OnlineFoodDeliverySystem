<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    
    <servlet>
        <servlet-name>ReviewServlet</servlet-name>
        <servlet-class>com.fooddelivery.review.ReviewServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>ReviewServlet</servlet-name>
        <url-pattern>/review/*</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>review_form.jsp</welcome-file>
    </welcome-file-list>

    <!-- Add error pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/review_form.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>
</web-app>
