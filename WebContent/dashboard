<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="user_manager.User" %>
<%
    // Retrieve the logged-in user from the session
    User user = (User) session.getAttribute("loggedInUser");
    if (user == null) {
        response.sendRedirect("login.jsp");
        return;
    }
%>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>User Dashboard</title>
    <style>
        body { font-family: Arial, sans-serif; }
        a { text-decoration: none; color: blue; margin-right: 10px; }
    </style>
</head>
<body>
    <h2>Welcome, <%= user.getName() %>!</h2>
    <p><strong>User ID:</strong> <%= user.getUserId() %></p>
    <p><strong>Email:</strong> <%= user.getEmail() %></p>
    <br/>
    <!-- Link to update profile page -->
    <a href="updateUser.jsp">Update Profile</a>
    <!-- Logout link -->
    <a href="LogoutServlet">Logout</a>
    <!-- Delete account link with userId passed as a query parameter -->
    <a href="DeleteUserServlet?userId=<%= user.getUserId() %>">Delete Account</a>
</body>
</html>
